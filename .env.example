# Copy to .env.local for local development. Never commit real values.
# In Vercel: Project Settings -> Environment Variables.

# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public browser key. Use the publishable key (sb_publishable_...) on new
# projects, or the legacy anon key via NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# SERVER ONLY. Secret key (sb_secret_...) or the legacy service_role key via
# SUPABASE_SERVICE_ROLE_KEY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# SERVER ONLY, optional. Only used by `npm run db:migrate` to apply the SQL
# migrations from the command line (Supabase -> Connect -> Session pooler URI,
# with your database password). Not needed if you paste the SQL by hand, and
# not needed on Vercel.
# SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Canonical site URL, no trailing slash (used for SEO metadata and sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional fallback. The WhatsApp number is normally managed in
# Admin -> Settings. Digits only with country code, e.g. 919876543210.
# WHATSAPP_NUMBER=

# Only used by `npm run db:admin` to create the first administrator.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
